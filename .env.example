# Copy to .env for local runs (never commit .env)

# Season (leave unset to auto-infer from calendar)
# FOOTBALL_SEASON=2627
# FOOTBALL_SEASON_LABEL=2026/2027

MAX_TRAIN_TEAMS=12
MIN_TEAM_MATCHES=25
N_SIMULATIONS=3000
ODDS_BLEND=0.30
TODAY_ONLY=1
DAILY_LIGHT=1

# SKIP_TRAIN=0
# SKIP_SIM=0

# Publish to admin Sim Lab
# SPORTINTEL_PUSH=1
# SPORTINTEL_REPO=avramnull/sportintel
# GITHUB_TOKEN=ghp_...

LOG_LEVEL=INFO
# LOG_JSON=0

# API-Football (api-sports) — live fixtures + standings
# API_FOOTBALL_KEY=                 # Africa fixtures (primary)
# API_FOOTBALL_STANDINGS_KEY=       # league standings (2nd key; optional)
# API_FOOTBALL_MAX_STANDINGS=0   # 0=all unique leagues on board; never per-team
# STANDINGS_STRENGTH=0.55
# SKIP_STANDINGS=0

# STANDINGS_ALLOW_API=0   # 1 only if paid API-Football (free plan = stale 2022-2024)

# ENABLE_LIVE_STANDINGS=0   # 1 to re-enable local/API table priors in pipeline
